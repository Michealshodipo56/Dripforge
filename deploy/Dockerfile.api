FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends docker.io ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/api/index.mjs /app/apps/api/index.mjs
COPY packages/core/src/github-pagination.mjs /app/packages/core/src/github-pagination.mjs
COPY apps/web/index.html /app/web/index.html
CMD ["node","/app/apps/api/index.mjs"]
